# ====================================================================
# Plaudia — Variables d'environnement (TEMPLATE VIERGE)
# ====================================================================
# Copier ce fichier en .env et remplacer TOUS les placeholders
# ATTENTION : Ne JAMAIS commit ce fichier avec des valeurs réelles
# ====================================================================

# --- BACKEND (FastAPI — sur le VPS Hermes) ---
# Copier dans /opt/data/.env sur le VPS

# Supabase — URL + clés du projet
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.votre_cle_anon_publique
SUPABASE_SERVICE_EMAIL=admin@votre-boite.fr
SUPABASE_SERVICE_PASSWORD=***_mot_de_passe_du_compte_service_***

# LLM
OPENAI_API_KEY=sk-pro-votre_cle_openai
OPENROUTER_API_KEY=sk-or-votre_cle_openrouter
ANTHROPIC_API_KEY=sk-ant-votre_cle_anthropic

# Clé partagée (fallback pour les crons uniquement)
PLAUDIA_SHARED_KEY=à_générer_avec_openssl_rand_-hex_32

# --- FRONTEND (Lovable — secrets serveur, PAS VITE_*) ---
# Déclarer dans Lovable → Settings → Secrets (pas en VITE_*)

# URL du backend exposée via Cloudflare Tunnel
PLAUDIA_BACKEND_URL=https://plaudia-api.votre-domaine.app

# Clé partagée backend <-> frontend (identique à PLAUDIA_SHARED_KEY backend)
PLAUDIA_SHARED_KEY=à_générer_avec_openssl_rand_-hex_32

# Cloudflare Access Service Token (si tunnel protégé)
CF_CLIENT_ID=votre_cf_service_token_id
CF_CLIENT_SECRET=votre_cf_service_token_secret

# --- FRONTEND (Lovable — variables publiques VITE_*) ---
# Déclarer dans Lovable → Settings → Environment Variables

# URL + clé publique du projet Supabase
VITE_HERONE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_HERONE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.votre_cle_anon

# --- GOOGLE OAUTH (optionnel — export Docs + Gmail) ---
# Le token OAuth est stocké dans /opt/data/google_token.json
# Google Cloud Console → APIs → OAuth 2.0 Client ID
GOOGLE_API_KEY=AIza_votre_cle_google

# --- GITHUB (optionnel — push automatique) ---
GITHUB_TOKEN=ghp_votre_token_github